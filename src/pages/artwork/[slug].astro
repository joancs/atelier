---
// getStaticPaths is how Astro builds a static site out of dynamic-looking
// URLs: at build time (not per-request — there's no server here), it asks
// "what are every possible value of [slug]?" and pre-renders one HTML file
// per artwork. That's part of why this is fast: nothing is computed when a
// visitor loads the page, it's just a plain file.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const artworks = await getCollection('artwork');
  return artworks.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, year, medium, dimensions, image, imageAlt, description } = entry.data;
---

<BaseLayout title={`${title} — Artist Name`} description={`${title}, ${year}, ${medium}.`}>
  <article class="container piece">
    <Image src={image} alt={imageAlt} widths={[600, 1200]} sizes="(min-width: 768px) 60vw, 92vw" />

    <div class="details">
      <h1>{title}</h1>
      <p class="meta">
        {year} &middot; {medium}
        {dimensions && <> &middot; {dimensions}</>}
      </p>
      {description && <p class="description">{description}</p>}
    </div>
  </article>
</BaseLayout>

<style>
  .piece {
    padding-block: var(--space-5) var(--space-6);
  }
  .details {
    margin-top: var(--space-4);
    max-width: 60ch;
  }
  .meta {
    color: var(--color-muted);
  }
  .description {
    margin-top: var(--space-3);
  }
</style>
