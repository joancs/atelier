// Cloudflare Workers config for the site itself.
//
// The site is plain pre-built files, so this Worker has no code of its own:
// Cloudflare just serves whatever `npm run build` put in dist/. Deploys happen
// automatically through Workers Builds on every push to main.
//
// (The GitHub login helper is a separate Worker — see oauth-worker/.)
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "atelier",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./dist",
    // Unknown URLs get dist/404.html (built from src/pages/404.astro) with a
    // real 404 status, instead of a bare error.
    "not_found_handling": "404-page"
  }
}
